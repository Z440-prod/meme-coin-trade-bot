# =============================================================================
#  MCTB environment file.  Copy to `.env` and fill in.  NEVER commit `.env`.
#    cp .env.example .env && chmod 600 .env
# =============================================================================
#  Not every machine needs every value.  The "Needed on" comment tells you
#  which of the three devices actually reads each one.
# =============================================================================

# --- Message bus -------------------------------------------------------------
# Needed on: ALL THREE devices.  Point every device at the SAME Redis.
# Use the LAN IP of whichever machine runs Redis (the Host PC by default).
MCTB_REDIS_URL=redis://192.168.1.50:6379/0
# Set this if you enabled `requirepass` in redis.conf (strongly recommended).
MCTB_REDIS_PASSWORD=

# --- Solana RPC --------------------------------------------------------------
# Needed on: Scout (RPi 1) and Brain (RPi 2).
# The free public endpoint is HEAVILY rate limited and will cost you fills.
# Get a free/cheap dedicated endpoint from Helius, QuickNode, Triton or Shyft.
MCTB_RPC_URL=https://api.mainnet-beta.solana.com
MCTB_RPC_WS_URL=wss://api.mainnet-beta.solana.com
# Optional second endpoint; used for cross-validation and automatic failover.
MCTB_RPC_URL_FALLBACK=

# --- PumpPortal --------------------------------------------------------------
# Needed on: Scout (RPi 1) for the data feed, Brain (RPi 2) for trade building.
# The data WebSocket works without a key for free subscriptions.
# A key is only required for metered subscriptions (token/account trade streams).
MCTB_PUMPPORTAL_API_KEY=

# --- Social (all optional) ---------------------------------------------------
# Needed on: Scout (RPi 1).  Leave blank to disable social scoring entirely —
# the system works fine without it, it just loses one feature.
MCTB_X_BEARER_TOKEN=
MCTB_TELEGRAM_BOT_TOKEN=
MCTB_TELEGRAM_CHAT_ID=

# --- LLM ---------------------------------------------------------------------
# Needed on: Brain (RPi 2).  URL of your llama.cpp server (see scripts/setup_llm.sh).
# If the LLM is on the same Pi, localhost is right.  If you offload it to the
# Host PC's GPU, put the Host PC's LAN IP here instead.
MCTB_LLM_BASE_URL=http://127.0.0.1:8080

# --- Wallet ------------------------------------------------------------------
# Needed on: Brain (RPi 2) — and ONLY there.  Never put this on any other box.
# Path to the ENCRYPTED keystore created by `mctb keystore create`.
# Your private key is never stored in plaintext and never leaves this machine.
MCTB_KEYSTORE_PATH=./secrets/trading.keystore
# Passphrase for the keystore. Leave EMPTY to be prompted interactively at
# startup (most secure). Set it only if you need unattended systemd restarts,
# and if you do, `chmod 600 .env` is mandatory.
MCTB_KEYSTORE_PASSPHRASE=

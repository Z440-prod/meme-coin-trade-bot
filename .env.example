# =============================================================================
#  MCTB environment file.  Copy to `.env` and fill in.  NEVER commit `.env`.
#    cp .env.example .env && chmod 600 .env
# =============================================================================
#  EVERY API KEY BELOW IS OPTIONAL.
#
#  With no keys at all the system runs on the free keyless providers —
#  DEX Screener, GoPlus, Rugcheck, Jupiter, Raydium and Meteora — which cover
#  market data, security screening and execution routing. That is a complete,
#  working system. Add keys only when you know what each one buys you.
#
#  See docs/PROVIDERS.md for the honest cost/benefit of each.
# =============================================================================


# ─────────────────────────────────────────────────────────────────────────────
#  CORE — needed on every device
# ─────────────────────────────────────────────────────────────────────────────

# Message bus. Point all three devices at the SAME Redis (host PC by default).
MCTB_REDIS_URL=redis://192.168.1.50:6379/0
MCTB_REDIS_PASSWORD=

# Solana RPC. Needed on Scout (RPi 1) and Brain (RPi 2).
# The free public endpoint is heavily rate limited and WILL cost you fills.
# A free Helius key below gives you a much better endpoint — see HELIUS.
MCTB_RPC_URL=https://api.mainnet-beta.solana.com
MCTB_RPC_WS_URL=wss://api.mainnet-beta.solana.com
MCTB_RPC_URL_FALLBACK=


# ─────────────────────────────────────────────────────────────────────────────
#  TIER 1 — free, and the biggest single upgrade available
# ─────────────────────────────────────────────────────────────────────────────

# HELIUS — free tier, genuinely generous. Get one at helius.dev.
# Does three jobs at once:
#   1. A fast RPC endpoint (set MCTB_RPC_URL to your Helius URL as well)
#   2. Parsed transactions, so wallet history is readable
#   3. Wallet funding lineage — which powers entity resolution, the feature
#      that stops five sybil wallets counting as five independent signals
MCTB_HELIUS_API_KEY=

# PUMPPORTAL — the pump.fun data feed. No key needed for the free streams;
# a key is only required for metered per-token/per-wallet trade streams.
MCTB_PUMPPORTAL_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
#  TIER 2 — paid, useful once you are already profitable
# ─────────────────────────────────────────────────────────────────────────────

# BIRDEYE — OHLCV, holder lists, trader counts. Billed per compute unit.
MCTB_BIRDEYE_API_KEY=

# CIELO — wallet PnL and real-time wallet feeds. The most practical of the
# smart-money services for Solana, and the cheapest.
MCTB_CIELO_API_KEY=

# JUPITER — optional paid key. The keyless "lite" host works fine; a key
# raises rate limits ~7x, which only matters at high trade frequency.
MCTB_JUPITER_API_KEY=

# SOLSCAN PRO — holder lists and account analytics.
MCTB_SOLSCAN_API_KEY=

# DUNE — custom SQL analytics. Batch only, never on a trading path.
MCTB_DUNE_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
#  TIER 3 — expensive; only worth it at real size
# ─────────────────────────────────────────────────────────────────────────────

# NANSEN — best-in-class wallet labelling, priced accordingly.
MCTB_NANSEN_API_KEY=

# ARKHAM — entity attribution, complements our own clustering.
MCTB_ARKHAM_API_KEY=

# LUNARCRUSH — social volume and sentiment metrics.
MCTB_LUNARCRUSH_API_KEY=

# KAITO — attention/mindshare scores. Used to grade the accounts shilling a
# token, which is more useful than raw mention counts.
MCTB_KAITO_API_KEY=

# DEXTOOLS — paid audit metrics. Set providers.dextools_plan in config.yaml
# to match your plan (trial | standard | advanced | pro).
MCTB_DEXTOOLS_API_KEY=

# TOKEN SNIFFER — thin Solana coverage; skip unless you also trade EVM.
MCTB_TOKENSNIFFER_API_KEY=

# RUGCHECK — works keyless. A key only raises rate limits.
MCTB_RUGCHECK_API_KEY=


# ─────────────────────────────────────────────────────────────────────────────
#  NO PUBLIC API — these are link-outs only
# ─────────────────────────────────────────────────────────────────────────────
#  Photon, BullX and Bubblemaps publish no usable API; MCTB deep-links to them
#  from the terminal instead. GMGN has undocumented internal endpoints that
#  can be enabled with providers.gmgn_opt_in: true in config.yaml — read the
#  warning in docs/PROVIDERS.md first.


# ─────────────────────────────────────────────────────────────────────────────
#  SOCIAL (optional)
# ─────────────────────────────────────────────────────────────────────────────

# X / Twitter. Note X API v2 has NO WebSocket — MCTB polls recent search.
# Do not pay for an X plan until the rest of the system is profitable.
MCTB_X_BEARER_TOKEN=


# ─────────────────────────────────────────────────────────────────────────────
#  ALERTS & AUTOMATION
# ─────────────────────────────────────────────────────────────────────────────

# Telegram: talk to @BotFather for a token, @userinfobot for your chat id.
MCTB_TELEGRAM_BOT_TOKEN=
MCTB_TELEGRAM_CHAT_ID=

# Discord: Server Settings → Integrations → Webhooks → New Webhook.
MCTB_DISCORD_WEBHOOK_URL=

# Inbound webhooks (TradingView / Zapier / n8n).
# Long random string — it is both the URL path and the HMAC key.
#   openssl rand -hex 32
# Required if you enable webhooks.allow_trading.
MCTB_WEBHOOK_SECRET=


# ─────────────────────────────────────────────────────────────────────────────
#  LLM & WALLET
# ─────────────────────────────────────────────────────────────────────────────

# Local llama.cpp server. Point at the host PC's IP to use its GPU instead.
MCTB_LLM_BASE_URL=http://127.0.0.1:8080

# Brain (RPi 2) ONLY. Never put this on any other machine.
MCTB_KEYSTORE_PATH=./secrets/trading.keystore
# Leave EMPTY to be prompted at startup (most secure). Set it only for
# unattended systemd restarts, and then `chmod 600 .env` is mandatory.
MCTB_KEYSTORE_PASSPHRASE=
